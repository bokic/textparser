          {
            "ref": "ScriptEndTag"
          }
        ]
      },
      "ScriptStartTag": {
        "astKind": "ScriptStartTag",
        "sequence": [
          {
            "token": "ScriptStartTag_Start"
          },
          {
            "repeat": {
              "ref": "Expression"
            }
          },
