{
  "$schema": "../schema/textparser-schema.json",
  "formatVersion": 2,
  "name": "cfml",
  "version": 1.0,
  "caseSensitivity": false,
  "defaultFileExtensions": [
    "cfm",
    "cfc"
  ],
  "defaultTextEncoding": "latin1",
  "supportedBom": "UTF-8,UTF-16-LE,UTF-16-BE",
  "otherTextInside": true,
  "lexer": {
    "initialMode": "default",
    "tokens": {
      "ScriptStartTag_Start": {
        "regex": "<cfscript(?=[\\>\\s])",
        "textColor": "0xabd90c"
      },
      "ScriptStartTag_End": {
        "regex": "\\/?>",
        "textColor": "0xabd90c"
      },
      "ScriptEndTag": {
        "regex": "<\\/cfscript>",
        "textColor": "0xabd90c"
      },
      "OutputStartTag_Start": {
        "regex": "<cfoutput(?=[\\>\\s])",
        "textColor": "0xabd90c"
      },
      "OutputStartTag_End": {
        "regex": "\\/?>",
        "textColor": "0xabd90c"
      },
      "OutputEndTag": {
        "regex": "<\\/cfoutput>",
        "textColor": "0xabd90c"
      },
      "QueryStartTag_Start": {
        "regex": "<cfquery(?=[\\>\\s])",
        "textColor": "0xabd90c"
      },
      "QueryStartTag_End": {
        "regex": "\\/?>",
        "textColor": "0xabd90c"
      },
      "QueryEndTag": {
        "regex": "<\\/cfquery>",
        "textColor": "0xabd90c"
      },
      "LoopStartTag_Start": {
        "regex": "<cfloop(?=[\\>\\s])",
        "textColor": "0xabd90c"
      },
      "LoopStartTag_End": {
        "regex": "\\/?>",
        "textColor": "0xabd90c"
      },
      "LoopEndTag": {
        "regex": "<\\/cfloop>",
        "textColor": "0xabd90c"
      },
      "StartTag_Start": {
        "regex": "<(?:cf[a-z0-9_]*|[a-zA-Z0-9_]+:[a-zA-Z0-9_]+)",
        "textColor": "0xabd90c"
      },
      "StartTag_End": {
        "regex": "\\/?>",
        "textColor": "0xabd90c"
      },
      "EndTag_Start": {
        "regex": "<\\/(?:cf(?!output)(?!script)(?!query)(?!loop)[a-z0-9_]*|[a-zA-Z0-9_]+:[a-zA-Z0-9_]+)",
        "textColor": "0xabd90c"
      },
      "EndTag_End": {
        "regex": "\\/?>",
        "textColor": "0xabd90c"
      },
      "Comment_Start": {
        "regex": "<!---"
      },
      "Comment_End": {
        "regex": "--->"
      },
      "SingleString_Start": {
        "regex": "'",
        "textColor": "0x9e6a57"
      },
      "SingleString_End": {
        "regex": "'",
        "textColor": "0x9e6a57"
      },
      "DoubleString_Start": {
        "regex": "\"",
        "textColor": "0x9e6a57"
      },
      "DoubleString_End": {
        "regex": "\"",
        "textColor": "0x9e6a57"
      },
      "SingleChar": {
        "regex": "''",
        "textColor": "0xd7ba7d"
      },
      "DoubleChar": {
        "regex": "\"\"",
        "textColor": "0xd7ba7d"
      },
      "SharpChar": {
        "regex": "##",
        "textColor": "0xd7ba7d"
      },
      "SharpExpression_Start": {
        "regex": "#",
        "textColor": "0x569cd6"
      },
      "SharpExpression_End": {
        "regex": "#",
        "textColor": "0x569cd6"
      },
      "ScriptBlockComment_Start": {
        "regex": "\\/\\*"
      },
      "ScriptBlockComment_End": {
        "regex": "\\*\\/"
      },
      "ExpressionEnd": {
        "regex": ";"
      },
      "Number": {
        "regex": "([0-9]+\\.?[0-9]*(?:[eE][-+]?[0-9]+)?|[0-9]*\\.[0-9]+(?:[eE][-+]?[0-9]+)?)",
        "textColor": "0xb5cea8"
      },
      "Boolean": {
        "regex": "true\\b|false\\b|yes\\b|no\\b"
      },
      "ObjectMember": {
        "regex": "\\?\\.|\\."
      },
      "Function": {
        "regex": "([a-z_]+[a-z0-9_]*)[\\s]*\\(",
        "textColor": "0xc5f566"
      },
      "Separator": {
        "regex": ","
      },
      "SpreadOperator": {
        "regex": "\\.\\.\\.",
        "textColor": "0x35b2dd"
      },
      "Variable": {
        "regex": "[a-z_\\$]+[a-z0-9_\\$]*",
        "textColor": "0x9cdcfe"
      },
      "LambdaOperator": {
        "regex": "=>",
        "textColor": "0x35b2dd"
      },
      "AssignOperator": {
        "regex": "\\+=|\\-=|\\*=|\\/=|%=|&=|=",
        "textColor": "0x35b2dd"
      },
      "TernaryOperator": {
        "regex": "\\?\\?|\\?:|\\?|\\:",
        "textColor": "0x35b2dd"
      },
      "LogicalImpOperator": {
        "regex": "imp\\b",
        "textColor": "0x35b2dd"
      },
      "LogicalEqvOperator": {
        "regex": "eqv\\b",
        "textColor": "0x35b2dd"
      },
      "LogicalXorOperator": {
        "regex": "xor\\b",
        "textColor": "0x35b2dd"
      },
      "LogicalOrOperator": {
        "regex": "\\|\\||or\\b",
        "textColor": "0x35b2dd"
      },
      "LogicalAndOperator": {
        "regex": "\\&\\&|and\\b",
        "textColor": "0x35b2dd"
      },
      "LogicalNotOperator": {
        "regex": "not\\b|!",
        "textColor": "0x35b2dd"
      },
      "CompareOperator": {
        "regex": "greater\\s+than\\s+or\\s+equal\\s+to\\b|less\\s+than\\s+or\\s+equal\\s+to\\b|does\\s+not\\s+contain\\b|is\\s+not\\b|contains\\b|less\\s+than\\b|greater\\s+than\\b|not\\s+equal\\b|equal\\b|neq\\b|lte\\b|gte\\b|eq\\b|===|!==|==|>=|<=|!=|ge\\b|lt\\b|gt\\b|le\\b|\\bis\\b|>|<",
        "textColor": "0x35b2dd"
      },
      "ConcatOperator": {
        "regex": "\\&",
        "textColor": "0x35b2dd"
      },
      "IncDecOperator": {
        "regex": "\\+\\+|\\-\\-",
        "textColor": "0x35b2dd"
      },
      "AddOperator": {
        "regex": "\\+|-",
        "textColor": "0x35b2dd"
      },
      "MulOperator": {
        "regex": "\\*|\\/|\\\\|mod\\b|\\%",
        "textColor": "0x35b2dd"
      },
      "PowerOperator": {
        "regex": "\\^",
        "textColor": "0x35b2dd"
      },
      "CodeBlock_Start": {
        "regex": "\\{",
        "textColor": "0xffd700"
      },
      "CodeBlock_End": {
        "regex": "\\}",
        "textColor": "0xffd700"
      },
      "Keyword": {
        "regex": "var\\b|function\\b|this\\b|super\\b|null\\b|try\\b|catch\\b|finally\\b|if\\b|then\\b|else\\b|switch\\b|case\\b|default\\b|break\\b|continue\\b|while\\b|do\\b|for\\b|in\\b|return\\b|throw\\b|rethrow\\b|retry\\b|component\\b|interface\\b|property\\b|pageencoding\\b|import\\b|include\\b|param\\b|lock\\b|transaction\\b|thread\\b|public\\b|private\\b|remote\\b|package\\b|static\\b|final\\b|abstract\\b|required\\b",
        "textColor": "0xc586c0"
      },
      "Parenthesis_Start": {
        "regex": "\\(",
        "textColor": "0xffd700"
      },
      "Parenthesis_End": {
        "regex": "\\)",
        "textColor": "0xffd700"
      },
      "ArrayIndex_Start": {
        "regex": "\\[",
        "textColor": "0xffd700"
      },
      "ArrayIndex_End": {
        "regex": "\\]",
        "textColor": "0xffd700"
      }
    },
    "trivia": {
      "ScriptLineComment": {
        "regex": "\\/\\/.*[^\\r\\n]"
      }
    }
  },
  "grammar": {
    "start": "Root",
    "productions": {
      "ScriptTagPair": {
        "astKind": "ScriptTagPair",
        "sequence": [
          {
            "ref": "ScriptStartTag"
