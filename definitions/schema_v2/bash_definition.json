{
  "$schema": "../schema/textparser-schema.json",
  "formatVersion": 2,
  "name": "bash",
  "version": 1.0,
  "caseSensitivity": true,
  "defaultFileExtensions": [
    "sh",
    "bash"
  ],
  "defaultTextEncoding": "utf-8",
  "otherTextInside": true,
  "lexer": {
    "initialMode": "default",
    "tokens": {
      "Keyword": {
        "regex": "if\\b|then\\b|else\\b|elif\\b|fi\\b|for\\b|while\\b|until\\b|do\\b|done\\b|in\\b|case\\b|esac\\b|select\\b|function\\b|time\\b|coproc\\b|alias\\b|bg\\b|bind\\b|break\\b|builtin\\b|caller\\b|cd\\b|command\\b|compgen\\b|complete\\b|compopt\\b|continue\\b|declare\\b|dirs\\b|disown\\b|echo\\b|enable\\b|eval\\b|exec\\b|exit\\b|export\\b|fc\\b|fg\\b|getopts\\b|hash\\b|help\\b|history\\b|jobs\\b|kill\\b|let\\b|local\\b|mapfile\\b|popd\\b|printf\\b|pushd\\b|pwd\\b|read\\b|readarray\\b|readonly\\b|return\\b|set\\b|shift\\b|shopt\\b|source\\b|suspend\\b|test\\b|times\\b|trap\\b|type\\b|typeset\\b|ulimit\\b|umask\\b|unalias\\b|unset\\b|wait\\b",
        "textColor": "0xc586c0"
      },
      "Boolean": {
        "regex": "true\\b|false\\b",
        "textColor": "0x569cd6"
      },
      "ArithmeticExpression_Start": {
        "regex": "\\$\\(\\(|\\(\\(",
        "textColor": "0xffd700"
      },
      "ArithmeticExpression_End": {
        "regex": "\\)\\)",
        "textColor": "0xffd700"
      },
      "CommandSubstitution_Start": {
        "regex": "\\$\\((?!\\()",
        "textColor": "0xce9178"
      },
      "CommandSubstitution_End": {
        "regex": "\\)",
        "textColor": "0xce9178"
      },
      "ProcessSubstitution_Start": {
        "regex": "<\\(|>\\(",
        "textColor": "0xce9178"
      },
      "ProcessSubstitution_End": {
        "regex": "\\)",
        "textColor": "0xce9178"
      },
      "BacktickSubstitution_Start": {
        "regex": "`",
        "textColor": "0x9e6a57"
      },
      "BacktickSubstitution_End": {
        "regex": "`",
        "textColor": "0x9e6a57"
      },
      "TestExpression_Start": {
        "regex": "\\[\\[",
        "textColor": "0xffd700"
      },
      "TestExpression_End": {
        "regex": "\\]\\]",
        "textColor": "0xffd700"
      },
      "Variable": {
        "regex": "\\$[a-zA-Z_][a-zA-Z0-9_]*|\\$[@*#?$!_0-9-]|[a-zA-Z_][a-zA-Z0-9_]*(?=\\+=|=|:-|:=|:\\+|:\\?)",
        "textColor": "0x9cdcfe"
      },
      "Path": {
        "regex": "[a-zA-Z0-9_.~-]*\\/[a-zA-Z0-9_.~/-]+",
        "textColor": "0xdcdcaa"
      },
      "Identifier": {
        "regex": "[a-zA-Z_][a-zA-Z0-9_]*",
        "textColor": "0xdcdcaa"
      },
      "ParameterExpansion_Start": {
        "regex": "\\$\\{",
        "textColor": "0x9cdcfe"
      },
      "ParameterExpansion_End": {
        "regex": "\\}",
        "textColor": "0x9cdcfe"
      },
      "CodeBlock_Start": {
        "regex": "\\{",
        "textColor": "0xffd700"
      },
      "CodeBlock_End": {
        "regex": "\\}",
        "textColor": "0xffd700"
      },
      "Operator": {
        "regex": "&&|\\|\\||>>|<<|==|!=|\\+=|\\-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|\\+\\+|\\-\\-|;;|;&|;;&|\\|&|<<<|<<-|>&|<&|&>>|&>|>\\||<>|<=|>=|=~|:-|:=|:\\+|:\\?|//|##|%%|\\^\\^|,,|[-+*/%&|^~<>!=;.,|:]",
        "textColor": "0xd4d4d4"
      },
      "ArithmeticOperator": {
        "regex": "\\*\\*|<<=|>>=|\\+=|\\-=|\\*=|/=|%=|&=|\\|=|\\^=|\\+\\+|\\-\\-|<<|>>|<=|>=|==|!=|&&|\\|\\||[-+*/%&|^~<>!=?:=]",
        "textColor": "0xd4d4d4"
      },
      "SingleString_Start": {
        "regex": "\\$?'",
        "textColor": "0x9e6a57"
      },
      "SingleString_End": {
        "regex": "'",
        "textColor": "0x9e6a57"
      },
      "DoubleString_Start": {
        "regex": "\\$?\"",
        "textColor": "0x9e6a57"
      },
      "DoubleString_End": {
        "regex": "\"",
        "textColor": "0x9e6a57"
      },
      "StringEscape": {
        "regex": "\\\\\\\\|\\\\\\\"|\\\\\\'|\\\\n|\\\\r|\\\\t|\\\\\\$|\\\\\\`|\\\\a|\\\\b|\\\\[eE]|\\\\f|\\\\v|\\\\\\?|\\\\x[0-9a-fA-F]{1,2}|\\\\u[0-9a-fA-F]{1,4}|\\\\U[0-9a-fA-F]{1,8}|\\\\c[a-zA-Z]|\\\\[0-7]{1,3}",
        "textColor": "0xd7ba7d"
      },
      "Number": {
        "regex": "0[xX][0-9a-fA-F]+|0[oO][0-7]+|0[bB][01]+|[0-9]+#[0-9a-zA-Z@_]+|[0-9]*\\.?[0-9]+(?:[eE][-+]?[0-9]+)?",
        "textColor": "0xb5cea8"
      },
      "Parenthesis_Start": {
        "regex": "\\(",
        "textColor": "0xffd700"
      },
      "Parenthesis_End": {
        "regex": "\\)",
        "textColor": "0xffd700"
      },
      "ArrayIndex_Start": {
        "regex": "\\[",
        "textColor": "0xffd700"
      },
      "ArrayIndex_End": {
        "regex": "\\]",
        "textColor": "0xffd700"
      }
    },
    "trivia": {
      "LineComment": {
        "regex": "#[^\\r\\n]*",
        "textColor": "0x6a9955"
      }
    }
  },
  "grammar": {
