                },
                {
                  "ref": "TemplateClose"
                },
                {
                  "ref": "Comma"
                },
                {
                  "ref": "SingleString"
                },
                {
                  "ref": "DoubleString"
                },
                {
                  "ref": "Number"
                }
              ]
            }
          },
          {
            "token": "CodeBlock_End"
          }
        ]
      },
      "ScopeResolution": {
        "token": "ScopeResolution"
      },
      "Operator": {
        "token": "Operator"
      },
      "PointerOrRef": {
        "token": "PointerOrRef"
      },
      "TemplateOpen": {
        "token": "TemplateOpen"
      },
      "TemplateClose": {
        "token": "TemplateClose"
      },
      "Comma": {
        "token": "Comma"
      },
      "SingleString": {
        "astKind": "SingleString",
        "sequence": [
          {
            "token": "SingleString_Start"
          },
          {
            "repeat": {
              "ref": "StringEscape"
            }
          },
          {
            "token": "SingleString_End"
          }
        ]
      },
      "DoubleString": {
        "astKind": "DoubleString",
        "sequence": [
          {
            "token": "DoubleString_Start"
          },
          {
            "repeat": {
              "ref": "StringEscape"
            }
          },
          {
            "token": "DoubleString_End"
          }
        ]
      },
      "StringEscape": {
        "token": "StringEscape"
      },
      "Number": {
        "token": "Number"
      },
      "Boolean": {
        "token": "Boolean"
      },
      "Parenthesis": {
        "astKind": "Parenthesis",
        "sequence": [
          {
            "token": "Parenthesis_Start"
          },
          {
            "repeat": {
              "choice": [
                {
                  "ref": "LineComment"
                },
                {
                  "ref": "BlockComment"
                },
                {
                  "ref": "Preprocessor"
                },
                {
                  "ref": "Boolean"
                },
                {
                  "ref": "TaggedType"
                },
                {
                  "ref": "Keyword"
                },
                {
                  "ref": "DataType"
                },
                {
                  "ref": "Variable"
                },
                {
                  "ref": "CodeBlock"
                },
                {
                  "ref": "ScopeResolution"
                },
                {
                  "ref": "Operator"
                },
                {
                  "ref": "PointerOrRef"
                },
                {
                  "ref": "TemplateOpen"
                },
                {
                  "ref": "TemplateClose"
                },
                {
                  "ref": "Comma"
                },
                {
                  "ref": "SingleString"
                },
                {
                  "ref": "DoubleString"
                },
                {
                  "ref": "Number"
                },
                {
                  "ref": "Parenthesis"
                },
                {
                  "ref": "ArrayIndex"
                }
              ]
            }
