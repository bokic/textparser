          },
          {
            "repeat": {
              "choice": [
                {
                  "ref": "LineComment"
                },
                {
                  "ref": "BlockComment"
                },
                {
                  "ref": "TaggedType"
                },
                {
                  "ref": "Keyword"
                },
                {
                  "ref": "DataType"
                },
                {
                  "ref": "Variable"
                },
                {
                  "ref": "ScopeResolution"
                },
                {
                  "ref": "Operator"
                },
                {
                  "ref": "PointerOrRef"
                },
                {
                  "ref": "TemplateOpen"
                },
                {
                  "ref": "TemplateClose"
                },
                {
                  "ref": "Comma"
                },
                {
                  "ref": "Number"
                },
                {
                  "ref": "Parenthesis"
                }
              ]
            }
          },
          {
            "token": "TemplateGroup_End"
          }
        ]
      },
      "TypeCast": {
        "astKind": "TypeCast",
        "sequence": [
          {
            "token": "TypeCast_Start"
          },
