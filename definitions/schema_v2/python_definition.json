{
  "$schema": "../schema/textparser-schema.json",
  "formatVersion": 2,
  "name": "python",
  "version": 1.0,
  "caseSensitivity": true,
  "defaultFileExtensions": [
    "py"
  ],
  "defaultTextEncoding": "latin1",
  "otherTextInside": true,
  "lexer": {
    "initialMode": "default",
    "tokens": {
      "TripleSingleString_Start": {
        "regex": "'''",
        "textColor": "0x557a44"
      },
      "TripleSingleString_End": {
        "regex": "'''",
        "textColor": "0x557a44"
      },
      "TripleDoubleString_Start": {
        "regex": "\"\"\"",
        "textColor": "0x557a44"
      },
      "TripleDoubleString_End": {
        "regex": "\"\"\"",
        "textColor": "0x557a44"
      },
      "SingleString_Start": {
        "regex": "'",
        "textColor": "0x9e6a57"
      },
      "SingleString_End": {
        "regex": "'",
        "textColor": "0x9e6a57"
      },
      "DoubleString_Start": {
        "regex": "\"",
        "textColor": "0x9e6a57"
      },
      "DoubleString_End": {
        "regex": "\"",
        "textColor": "0x9e6a57"
      },
      "FString_Start": {
        "regex": "[fF](?:\"\"\"|'''|\"|')",
        "textColor": "0x9e6a57"
      },
      "FString_End": {
        "regex": "(?:\"\"\"|'''|\"|')",
        "textColor": "0x9e6a57"
      },
      "FStringInterpolation_Start": {
        "regex": "\\{",
        "textColor": "0x4075a0"
      },
      "FStringInterpolation_End": {
        "regex": "\\}",
        "textColor": "0x4075a0"
      },
      "StringEscape": {
        "regex": "\\\\[\\\\\\\"'nrt0]|\\\\x[0-9a-fA-F]{2}|\\\\u[0-9a-fA-F]{4}|\\\\U[0-9a-fA-F]{8}|\\\\N\\{[a-zA-Z_][a-zA-Z0-9_]*\\}",
        "textColor": "0xd7ba7d"
      },
      "Keyword": {
        "regex": "None\\b|and\\b|as\\b|assert\\b|async\\b|await\\b|break\\b|class\\b|continue\\b|def\\b|del\\b|elif\\b|else\\b|except\\b|finally\\b|for\\b|from\\b|global\\b|if\\b|import\\b|in\\b|is\\b|lambda\\b|nonlocal\\b|not\\b|or\\b|pass\\b|raise\\b|return\\b|try\\b|while\\b|with\\b|yield\\b",
        "textColor": "0xc586c0"
      },
      "Boolean": {
        "regex": "True\\b|False\\b",
        "textColor": "0x569cd6"
      },
      "Number": {
        "regex": "0[xX][0-9a-fA-F][0-9a-fA-F_]*|0[oO][0-7][0-7_]*|0[bB][01][01_]*|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][-+]?[0-9][0-9_]*)?[jJ]?",
        "textColor": "0xb5cea8"
      },
      "Variable": {
        "regex": "@?[a-zA-Z_][a-zA-Z0-9_]*",
        "textColor": "0x9cdcfe"
      },
      "Operator": {
        "regex": ":=|\\.\\.\\.|->|//|\\*\\*|<<|>>|==|!=|<=|>=|\\+=|\\-=|\\*=|\\/=|//=|%=|@=|&=|\\|=|\\^=|<<=|>>=|\\*\\*=|[=<>!&|^~+\\-*/%@.,;:]",
        "textColor": "0xd4d4d4"
      },
      "Parenthesis_Start": {
        "regex": "\\(",
        "textColor": "0xffd700"
      },
      "Parenthesis_End": {
        "regex": "\\)",
        "textColor": "0xffd700"
      },
      "ArrayIndex_Start": {
        "regex": "\\[",
        "textColor": "0xffd700"
      },
      "ArrayIndex_End": {
        "regex": "\\]",
        "textColor": "0xffd700"
      },
      "CodeBlock_Start": {
        "regex": "\\{",
        "textColor": "0xffd700"
      },
      "CodeBlock_End": {
        "regex": "\\}",
        "textColor": "0xffd700"
      }
    },
    "trivia": {
      "LineComment": {
        "regex": "#[^\\r\\n]*",
        "textColor": "0x6a9955"
      }
    }
  },
  "grammar": {
    "start": "Root",
    "productions": {
      "LineComment": {
        "token": "LineComment"
      },
      "TripleSingleString": {
        "astKind": "TripleSingleString",
        "sequence": [
          {
            "token": "TripleSingleString_Start"
          },
          {
            "token": "TripleSingleString_End"
          }
        ]
      },
      "TripleDoubleString": {
        "astKind": "TripleDoubleString",
        "sequence": [
          {
            "token": "TripleDoubleString_Start"
          },
          {
            "token": "TripleDoubleString_End"
          }
        ]
      },
      "SingleString": {
        "astKind": "SingleString",
        "sequence": [
          {
            "token": "SingleString_Start"
          },
          {
            "repeat": {
              "ref": "StringEscape"
            }
          },
          {
            "token": "SingleString_End"
          }
        ]
      },
      "DoubleString": {
        "astKind": "DoubleString",
        "sequence": [
          {
            "token": "DoubleString_Start"
          },
          {
            "repeat": {
              "ref": "StringEscape"
            }
          },
          {
            "token": "DoubleString_End"
          }
        ]
      },
      "FString": {
        "astKind": "FString",
        "sequence": [
          {
            "token": "FString_Start"
          },
          {
            "repeat": {
              "choice": [
                {
                  "ref": "StringEscape"
                },
                {
                  "ref": "FStringInterpolation"
                }
              ]
            }
          },
          {
            "token": "FString_End"
          }
        ]
      },
      "FStringInterpolation": {
        "astKind": "FStringInterpolation",
        "sequence": [
          {
            "token": "FStringInterpolation_Start"
          },
          {
            "repeat": {
              "choice": [
                {
                  "ref": "Keyword"
                },
                {
                  "ref": "Boolean"
                },
                {
                  "ref": "Number"
                },
                {
                  "ref": "Variable"
                },
                {
                  "ref": "Operator"
                },
                {
                  "ref": "Parenthesis"
                },
                {
                  "ref": "ArrayIndex"
                },
                {
                  "ref": "CodeBlock"
                }
              ]
            }
          },
          {
            "token": "FStringInterpolation_End"
          }
        ]
      },
      "StringEscape": {
        "token": "StringEscape"
      },
      "Keyword": {
        "token": "Keyword"
      },
      "Boolean": {
        "token": "Boolean"
      },
      "Number": {
        "token": "Number"
      },
      "Variable": {
        "token": "Variable"
      },
      "Operator": {
        "token": "Operator"
      },
      "Parenthesis": {
        "astKind": "Parenthesis",
        "sequence": [
          {
            "token": "Parenthesis_Start"
          },
          {
            "repeat": {
              "choice": [
                {
                  "ref": "LineComment"
                },
                {
                  "ref": "TripleSingleString"
                },
                {
                  "ref": "TripleDoubleString"
                },
                {
                  "ref": "SingleString"
                },
                {
                  "ref": "DoubleString"
                },
                {
                  "ref": "FString"
                },
                {
                  "ref": "Boolean"
                },
                {
                  "ref": "Keyword"
                },
                {
                  "ref": "Number"
                },
                {
                  "ref": "Variable"
                },
                {
                  "ref": "Operator"
                },
                {
                  "ref": "FStringInterpolation"
                },
                {
                  "ref": "Parenthesis"
                },
                {
                  "ref": "ArrayIndex"
                },
                {
                  "ref": "CodeBlock"
                }
              ]
            }
          },
          {
            "token": "Parenthesis_End"
          }
        ]
      },
      "ArrayIndex": {
        "astKind": "ArrayIndex",
        "sequence": [
          {
            "token": "ArrayIndex_Start"
          },
          {
            "repeat": {
              "choice": [
                {
                  "ref": "LineComment"
                },
                {
                  "ref": "TripleSingleString"
                },
                {
                  "ref": "TripleDoubleString"
                },
                {
                  "ref": "SingleString"
                },
                {
                  "ref": "DoubleString"
                },
                {
                  "ref": "FString"
                },
                {
                  "ref": "Boolean"
                },
                {
                  "ref": "Keyword"
                },
                {
                  "ref": "Number"
                },
                {
                  "ref": "Variable"
                },
                {
                  "ref": "Operator"
                },
                {
                  "ref": "FStringInterpolation"
                },
                {
                  "ref": "Parenthesis"
                },
                {
                  "ref": "ArrayIndex"
                },
                {
                  "ref": "CodeBlock"
                }
              ]
            }
          },
          {
            "token": "ArrayIndex_End"
          }
        ]
      },
      "CodeBlock": {
        "astKind": "CodeBlock",
        "sequence": [
          {
            "token": "CodeBlock_Start"
          },
          {
            "repeat": {
              "choice": [
                {
                  "ref": "LineComment"
                },
                {
                  "ref": "TripleSingleString"
                },
                {
                  "ref": "TripleDoubleString"
                },
                {
                  "ref": "SingleString"
                },
                {
                  "ref": "DoubleString"
                },
                {
                  "ref": "FString"
                },
                {
                  "ref": "Boolean"
                },
                {
                  "ref": "Keyword"
                },
                {
                  "ref": "Number"
                },
                {
                  "ref": "Variable"
                },
                {
                  "ref": "Operator"
                },
                {
                  "ref": "FStringInterpolation"
                },
                {
                  "ref": "Parenthesis"
                },
                {
                  "ref": "ArrayIndex"
                },
                {
                  "ref": "CodeBlock"
                }
              ]
            }
          },
          {
            "token": "CodeBlock_End"
          }
        ]
      },
      "Root": {
        "choice": [
          {
            "ref": "LineComment"
          },
          {
            "ref": "TripleSingleString"
          },
          {
            "ref": "TripleDoubleString"
          },
          {
            "ref": "SingleString"
          },
          {
            "ref": "DoubleString"
          },
          {
            "ref": "FString"
          },
          {
            "ref": "Boolean"
          },
          {
            "ref": "Keyword"
          },
          {
            "ref": "Number"
          },
          {
            "ref": "Variable"
          },
          {
            "ref": "Operator"
          },
          {
            "ref": "Parenthesis"
          },
          {
            "ref": "ArrayIndex"
          },
          {
            "ref": "CodeBlock"
          }
        ]
      }
    }
  }
}