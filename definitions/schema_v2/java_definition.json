{
  "$schema": "../schema/textparser-schema.json",
  "formatVersion": 2,
  "name": "java",
  "version": 1.0,
  "caseSensitivity": true,
  "defaultFileExtensions": [
    "java"
  ],
  "defaultTextEncoding": "latin1",
  "otherTextInside": true,
  "lexer": {
    "initialMode": "default",
    "tokens": {
      "BlockComment_Start": {
        "regex": "\\/\\*",
        "textColor": "0x6a9955"
      },
      "BlockComment_End": {
        "regex": "\\*\\/",
        "textColor": "0x6a9955"
      },
      "Annotation": {
        "regex": "@[a-zA-Z_][a-zA-Z0-9_]*",
        "textColor": "0xd7ba7d"
      },
      "Keyword": {
        "regex": "class\\b|interface\\b|enum\\b|extends\\b|implements\\b|package\\b|import\\b|public\\b|private\\b|protected\\b|static\\b|final\\b|void\\b|int\\b|double\\b|float\\b|long\\b|short\\b|byte\\b|char\\b|boolean\\b|if\\b|else\\b|for\\b|while\\b|do\\b|switch\\b|case\\b|default\\b|break\\b|continue\\b|return\\b|new\\b|this\\b|super\\b|try\\b|catch\\b|finally\\b|throw\\b|throws\\b|instanceof\\b|synchronized\\b|volatile\\b|transient\\b|abstract\\b|native\\b|strictfp\\b|assert\\b|null\\b|var\\b",
        "textColor": "0xc586c0"
      },
      "Variable": {
        "regex": "[a-zA-Z_][a-zA-Z0-9_]*",
        "textColor": "0x9cdcfe"
      },
      "CodeBlock_Start": {
        "regex": "\\{",
        "textColor": "0xffd700"
      },
      "CodeBlock_End": {
        "regex": "\\}",
        "textColor": "0xffd700"
      },
      "Operator": {
        "regex": "\\+=|\\-=|\\*=|\\/=|%=|&=|\\^=|\\|=|<{2}=|>{2,3}=|\\+\\+|\\-\\-|&&|\\|\\||<=|>=|==|!=|->|::|[=<>!&|^~+\\-*/%\\?:;.,]",
        "textColor": "0xd4d4d4"
      },
      "SingleString_Start": {
        "regex": "'",
        "textColor": "0x9e6a57"
      },
      "SingleString_End": {
        "regex": "'",
        "textColor": "0x9e6a57"
      },
      "DoubleString_Start": {
        "regex": "\"",
        "textColor": "0x9e6a57"
      },
      "DoubleString_End": {
        "regex": "\"",
        "textColor": "0x9e6a57"
      },
      "StringEscape": {
        "regex": "\\\\\\\\|\\\\\\\"|\\\\\\'|\\\\n|\\\\r|\\\\t|\\\\u[0-9a-fA-F]{4}",
        "textColor": "0xd7ba7d"
      },
      "Number": {
        "regex": "(?:0[xX][0-9a-fA-F][0-9a-fA-F_]*[lL]*|0[bB][01][01_]*[lL]*|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][-+]?[0-9_]+)?[fFdDlL]?)",
        "textColor": "0xb5cea8"
      },
      "Boolean": {
        "regex": "true\\b|false\\b",
        "textColor": "0x569cd6"
      },
      "Parenthesis_Start": {
        "regex": "\\(",
        "textColor": "0xffd700"
      },
      "Parenthesis_End": {
        "regex": "\\)",
        "textColor": "0xffd700"
      },
      "ArrayIndex_Start": {
        "regex": "\\[",
        "textColor": "0xffd700"
      },
      "ArrayIndex_End": {
        "regex": "\\]",
        "textColor": "0xffd700"
      }
    },
    "trivia": {
      "LineComment": {
        "regex": "\\/\\/[^\\r\\n]*",
        "textColor": "0x6a9955"
      }
    }
  },
  "grammar": {
    "start": "Root",
    "productions": {
      "LineComment": {
        "token": "LineComment"
      },
      "BlockComment": {
        "astKind": "BlockComment",
        "sequence": [
          {
            "token": "BlockComment_Start"
          },
          {
            "token": "BlockComment_End"
          }
        ]
      },
      "Annotation": {
        "token": "Annotation"
      },
      "Keyword": {
        "token": "Keyword"
      },
      "Variable": {
        "token": "Variable"
      },
      "CodeBlock": {
        "astKind": "CodeBlock",
        "sequence": [
          {
            "token": "CodeBlock_Start"
          },
          {
            "repeat": {
              "choice": [
                {
                  "ref": "LineComment"
                },
                {
                  "ref": "BlockComment"
                },
                {
                  "ref": "Annotation"
                },
                {
                  "ref": "Boolean"
                },
                {
                  "ref": "Keyword"
                },
                {
                  "ref": "Variable"
                },
                {
                  "ref": "CodeBlock"
                },
                {
                  "ref": "Operator"
                },
                {
                  "ref": "SingleString"
                },
                {
                  "ref": "DoubleString"
                },
                {
                  "ref": "Number"
                }
              ]
            }
          },
          {
            "token": "CodeBlock_End"
          }
        ]
      },
      "Operator": {
        "token": "Operator"
      },
      "SingleString": {
        "astKind": "SingleString",
        "sequence": [
          {
            "token": "SingleString_Start"
          },
          {
            "repeat": {
              "ref": "StringEscape"
            }
          },
          {
            "token": "SingleString_End"
          }
        ]
      },
      "DoubleString": {
        "astKind": "DoubleString",
        "sequence": [
          {
            "token": "DoubleString_Start"
          },
          {
            "repeat": {
              "ref": "StringEscape"
            }
          },
          {
            "token": "DoubleString_End"
          }
        ]
      },
      "StringEscape": {
        "token": "StringEscape"
      },
      "Number": {
        "token": "Number"
      },
      "Boolean": {
        "token": "Boolean"
      },
      "Parenthesis": {
        "astKind": "Parenthesis",
        "sequence": [
          {
            "token": "Parenthesis_Start"
          },
          {
            "repeat": {
              "choice": [
                {
                  "ref": "LineComment"
                },
                {
                  "ref": "BlockComment"
                },
                {
                  "ref": "Annotation"
                },
                {
                  "ref": "Boolean"
                },
                {
                  "ref": "Keyword"
                },
                {
                  "ref": "Variable"
                },
                {
                  "ref": "CodeBlock"
                },
                {
                  "ref": "Operator"
                },
                {
                  "ref": "SingleString"
                },
                {
                  "ref": "DoubleString"
                },
                {
                  "ref": "Number"
                },
                {
                  "ref": "Parenthesis"
                },
                {
                  "ref": "ArrayIndex"
                }
              ]
            }
          },
          {
            "token": "Parenthesis_End"
          }
        ]
      },
      "ArrayIndex": {
        "astKind": "ArrayIndex",
        "sequence": [
          {
            "token": "ArrayIndex_Start"
          },
          {
            "repeat": {
              "choice": [
                {
                  "ref": "LineComment"
                },
                {
                  "ref": "BlockComment"
                },
                {
                  "ref": "Annotation"
                },
                {
                  "ref": "Boolean"
                },
                {
                  "ref": "Keyword"
                },
                {
                  "ref": "Variable"
                },
                {
                  "ref": "CodeBlock"
                },
                {
                  "ref": "Operator"
                },
                {
                  "ref": "SingleString"
                },
                {
                  "ref": "DoubleString"
                },
                {
                  "ref": "Number"
                },
                {
                  "ref": "Parenthesis"
                },
                {
                  "ref": "ArrayIndex"
                }
              ]
            }
          },
          {
            "token": "ArrayIndex_End"
          }
        ]
      },
      "Root": {
        "choice": [
          {
            "ref": "LineComment"
          },
          {
            "ref": "BlockComment"
          },
          {
            "ref": "Annotation"
          },
          {
            "ref": "Boolean"
          },
          {
            "ref": "Keyword"
          },
          {
            "ref": "Variable"
          },
          {
            "ref": "CodeBlock"
          },
          {
            "ref": "Operator"
          },
          {
            "ref": "SingleString"
          },
          {
            "ref": "DoubleString"
          },
          {
            "ref": "Number"
          },
          {
            "ref": "Parenthesis"
          },
          {
            "ref": "ArrayIndex"
          }
        ]
      }
    }
  }
}