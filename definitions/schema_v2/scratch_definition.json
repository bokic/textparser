{
  "$schema": "../schema/textparser-schema.json",
  "formatVersion": 2,
  "name": "scratch",
  "version": 1.0,
  "caseSensitivity": true,
  "defaultFileExtensions": [
    "sb3"
  ],
  "defaultTextEncoding": "latin1",
  "otherTextInside": true,
  "lexer": {
    "initialMode": "default",
    "tokens": {
      "Keyword": {
        "regex": "when\\b|green\\b|flag\\b|clicked\\b|key\\b|pressed\\b|space\\b|any\\b|move\\b|steps\\b|turn\\b|cw\\b|ccw\\b|degrees\\b|go\\b|to\\b|glide\\b|secs\\b|point\\b|towards\\b|direction\\b|change\\b|set\\b|effect\\b|size\\b|graphic\\b|clear\\b|show\\b|hide\\b|say\\b|think\\b|seconds\\b|wait\\b|costume\\b|backdrop\\b|switch\\b|next\\b|sound\\b|play\\b|until\\b|stop\\b|all\\b|this\\b|sprite\\b|script\\b|create\\b|clone\\b|delete\\b|forever\\b|repeat\\b|if\\b|then\\b|else\\b|end\\b|for\\b|broadcast\\b|message\\b|message1\\b|new\\b|ask\\b|answer\\b|mouse\\b|x\\b|y\\b|down\\b|loudness\\b|timer\\b|reset\\b|random\\b|pick\\b|between\\b|join\\b|letter\\b|of\\b|length\\b|contains\\b|round\\b|sqrt\\b|abs\\b|and\\b|or\\b|not\\b|touching\\b|color\\b|distance\\b|item\\b|list\\b|add\\b|insert\\b|replace\\b|counter\\b|mod\\b",
        "textColor": "0xc586c0"
      },
      "Boolean": {
        "regex": "true\\b|false\\b",
        "textColor": "0x569cd6"
      },
      "DoubleString_Start": {
        "regex": "\"",
        "textColor": "0x9e6a57"
      },
      "DoubleString_End": {
        "regex": "\"",
        "textColor": "0x9e6a57"
      },
      "Number": {
        "regex": "[0-9]*\\.?[0-9]+",
        "textColor": "0xb5cea8"
      },
      "Variable": {
        "regex": "[a-zA-Z_][a-zA-Z0-9_]*|\\[[a-zA-Z_][a-zA-Z0-9_]*\\]",
        "textColor": "0x9cdcfe"
      },
      "Operator": {
        "regex": "[=<>+\\-*/]",
        "textColor": "0xd4d4d4"
      },
      "Parenthesis_Start": {
        "regex": "\\(",
        "textColor": "0xffd700"
      },
      "Parenthesis_End": {
        "regex": "\\)",
        "textColor": "0xffd700"
      },
      "ArrayIndex_Start": {
        "regex": "\\[",
        "textColor": "0xffd700"
      },
      "ArrayIndex_End": {
        "regex": "\\]",
        "textColor": "0xffd700"
      },
      "CodeBlock_Start": {
        "regex": "\\{",
        "textColor": "0xffd700"
      },
      "CodeBlock_End": {
        "regex": "\\}",
        "textColor": "0xffd700"
      }
    },
    "trivia": {
      "LineComment": {
        "regex": "#[^\\r\\n]*|\\/\\/[^\\r\\n]*",
        "textColor": "0x6a9955"
      }
    }
  },
  "grammar": {
    "start": "Root",
    "productions": {
      "LineComment": {
        "token": "LineComment"
      },
      "Keyword": {
        "token": "Keyword"
      },
      "Boolean": {
        "token": "Boolean"
      },
      "DoubleString": {
        "astKind": "DoubleString",
        "sequence": [
          {
            "token": "DoubleString_Start"
          },
          {
            "token": "DoubleString_End"
          }
        ]
      },
      "Number": {
        "token": "Number"
      },
      "Variable": {
        "token": "Variable"
      },
      "Operator": {
        "token": "Operator"
      },
      "Parenthesis": {
        "astKind": "Parenthesis",
        "sequence": [
          {
            "token": "Parenthesis_Start"
          },
          {
            "repeat": {
              "choice": [
                {
                  "ref": "LineComment"
                },
                {
                  "ref": "Boolean"
                },
                {
                  "ref": "Keyword"
                },
                {
                  "ref": "DoubleString"
                },
                {
                  "ref": "Number"
                },
                {
                  "ref": "Variable"
                },
                {
                  "ref": "Operator"
                },
                {
                  "ref": "Parenthesis"
                },
                {
                  "ref": "ArrayIndex"
                },
                {
                  "ref": "CodeBlock"
                }
              ]
            }
          },
          {
            "token": "Parenthesis_End"
          }
        ]
      },
      "ArrayIndex": {
        "astKind": "ArrayIndex",
        "sequence": [
          {
            "token": "ArrayIndex_Start"
          },
          {
            "repeat": {
              "choice": [
                {
                  "ref": "LineComment"
                },
                {
                  "ref": "Boolean"
                },
                {
                  "ref": "Keyword"
                },
                {
                  "ref": "DoubleString"
                },
                {
                  "ref": "Number"
                },
                {
                  "ref": "Variable"
                },
                {
                  "ref": "Operator"
                },
                {
                  "ref": "Parenthesis"
                },
                {
                  "ref": "ArrayIndex"
                },
                {
                  "ref": "CodeBlock"
                }
              ]
            }
          },
          {
            "token": "ArrayIndex_End"
          }
        ]
      },
      "CodeBlock": {
        "astKind": "CodeBlock",
        "sequence": [
          {
            "token": "CodeBlock_Start"
          },
          {
            "repeat": {
              "choice": [
                {
                  "ref": "LineComment"
                },
                {
                  "ref": "Boolean"
                },
                {
                  "ref": "Keyword"
                },
                {
                  "ref": "DoubleString"
                },
                {
                  "ref": "Number"
                },
                {
                  "ref": "Variable"
                },
                {
                  "ref": "Operator"
                },
                {
                  "ref": "Parenthesis"
                },
                {
                  "ref": "ArrayIndex"
                },
                {
                  "ref": "CodeBlock"
                }
              ]
            }
          },
          {
            "token": "CodeBlock_End"
          }
        ]
      },
      "Root": {
        "choice": [
          {
            "ref": "LineComment"
          },
          {
            "ref": "Boolean"
          },
          {
            "ref": "Keyword"
          },
          {
            "ref": "DoubleString"
          },
          {
            "ref": "Number"
          },
          {
            "ref": "Variable"
          },
          {
            "ref": "Operator"
          },
          {
            "ref": "Parenthesis"
          },
          {
            "ref": "ArrayIndex"
          },
          {
            "ref": "CodeBlock"
          }
        ]
      }
    }
  }
}