{
  "name": "cpp",
  "version": 1.0,
  "caseSensitivity": true,
  "defaultFileExtensions": [
    "cpp",
    "hpp",
    "cc",
    "cxx"
  ],
  "defaultTextEncoding": "latin1",
  "startTokens": [
    "LineComment",
    "BlockComment",
    "Preprocessor",
    "Boolean",
    "TaggedType",
    "Keyword",
    "DataType",
    "Variable",
    "CodeBlock",
    "ScopeResolution",
    "Operator",
    "PointerOrRef",
    "TemplateOpen",
    "TemplateClose",
    "Comma",
    "SingleString",
    "DoubleString",
    "Number",
    "Parenthesis",
    "ArrayIndex"
  ],
  "otherTextInside": true,
  "tokens": {
    "LineComment": {
      "type": "SimpleToken",
      "startRegex": "\\/\\/[^\\r\\n]*",
      "otherTextInside": true,
      "textColor": "0x6a9955"
    },
    "BlockComment": {
      "type": "StartStop",
      "startRegex": "\\/\\*",
      "endRegex": "\\*\\/",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0x6a9955"
    },
    "Preprocessor": {
      "type": "SimpleToken",
      "startRegex": "#[ \\t]*[a-zA-Z_][a-zA-Z0-9_]*",
      "textColor": "0xd7ba7d"
    },
    "Keyword": {
      "type": "SimpleToken",
      "startRegex": "namespace\\b|template\\b|typename\\b|using\\b|public\\b|private\\b|protected\\b|virtual\\b|override\\b|final\\b|friend\\b|operator\\b|this\\b|new\\b|delete\\b|throw\\b|catch\\b|try\\b|constexpr\\b|consteval\\b|constinit\\b|decltype\\b|explicit\\b|export\\b|import\\b|module\\b|mutable\\b|noexcept\\b|nullptr\\b|static_cast\\b|dynamic_cast\\b|const_cast\\b|reinterpret_cast\\b|thread_local\\b|concept\\b|requires\\b|co_await\\b|co_return\\b|co_yield\\b|typedef\\b|const\\b|static\\b|extern\\b|volatile\\b|if\\b|else\\b|for\\b|while\\b|do\\b|switch\\b|case\\b|default\\b|break\\b|continue\\b|return\\b|sizeof\\b|goto\\b|register\\b|auto\\b|inline\\b|restrict\\b",
      "textColor": "0xc586c0"
    },
    "Variable": {
      "type": "SimpleToken",
      "startRegex": "[a-zA-Z_][a-zA-Z0-9_]*",
      "textColor": "0x9cdcfe"
    },
    "CodeBlock": {
      "type": "StartStop",
      "startRegex": "\\{",
      "endRegex": "\\}",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xffd700",
      "nestedTokens": [
        "LineComment",
        "BlockComment",
        "Preprocessor",
        "Boolean",
        "TaggedType",
        "Keyword",
        "DataType",
        "Variable",
        "CodeBlock",
        "ScopeResolution",
        "Operator",
        "PointerOrRef",
        "TemplateOpen",
        "TemplateClose",
        "Comma",
        "SingleString",
        "DoubleString",
        "Number"
      ]
    },
    "ScopeResolution": {
      "type": "SimpleToken",
      "startRegex": "::",
      "textColor": "0xd4d4d4"
    },
    "Operator": {
      "type": "SimpleToken",
      "startRegex": "\\+=|\\-=|\\*=|\\/=|%=|&=|\\^=|\\|=|<{2}=|>{2}=|<{2}|>{2}|\\+\\+|\\-\\-|&&|\\|\\||<=>|<=|>=|==|!=|->\\*|->|\\.\\*|\\.|[=!|^~+\\-/%\\?:;.]",
      "textColor": "0xd4d4d4"
    },
    "PointerOrRef": {
      "type": "SimpleToken",
      "startRegex": "[*&]",
      "textColor": "0xd4d4d4"
    },
    "TemplateOpen": {
      "type": "SimpleToken",
      "startRegex": "<",
      "textColor": "0xd4d4d4"
    },
    "TemplateClose": {
      "type": "SimpleToken",
      "startRegex": ">",
      "textColor": "0xd4d4d4"
    },
    "Comma": {
      "type": "SimpleToken",
      "startRegex": ",",
      "textColor": "0xd4d4d4"
    },
    "SingleString": {
      "type": "StartStop",
      "startRegex": "'",
      "endRegex": "'",
      "otherTextInside": true,
      "textColor": "0xce9178",
      "nestedTokens": [
        "StringEscape"
      ]
    },
    "DoubleString": {
      "type": "StartStop",
      "startRegex": "\"",
      "endRegex": "\"",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xce9178",
      "nestedTokens": [
        "StringEscape"
      ]
    },
    "StringEscape": {
      "type": "SimpleToken",
      "startRegex": "\\\\\\\\|\\\\\\\"|\\\\\\'|\\\\n|\\\\r|\\\\t|\\\\u[0-9a-fA-F]{4}|\\\\x[0-9a-fA-F]{2}",
      "textColor": "0xd7ba7d"
    },
    "Number": {
      "type": "SimpleToken",
      "startRegex": "(?:0[xX][0-9a-fA-F]+[uUlL]*|0[bB][01]+[uUlL]*|[0-9]*\\.?[0-9]+(?:[eE][-+]?[0-9]+)?[fFdDlL]?)",
      "textColor": "0xb5cea8"
    },
    "Boolean": {
      "type": "SimpleToken",
      "startRegex": "true\\b|false\\b",
      "textColor": "0x569cd6"
    },
    "Parenthesis": {
      "type": "StartStop",
      "startRegex": "\\(",
      "endRegex": "\\)",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xffd700",
      "nestedTokens": [
        "LineComment",
        "BlockComment",
        "Preprocessor",
        "Boolean",
        "TaggedType",
        "Keyword",
        "DataType",
        "Variable",
        "CodeBlock",
        "ScopeResolution",
        "Operator",
        "PointerOrRef",
        "TemplateOpen",
        "TemplateClose",
        "Comma",
        "SingleString",
        "DoubleString",
        "Number",
        "Parenthesis",
        "ArrayIndex"
      ]
    },
    "ArrayIndex": {
      "type": "StartStop",
      "startRegex": "\\[",
      "endRegex": "\\]",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xffd700",
      "nestedTokens": [
        "LineComment",
        "BlockComment",
        "Preprocessor",
        "Boolean",
        "TaggedType",
        "Keyword",
        "DataType",
        "Variable",
        "CodeBlock",
        "ScopeResolution",
        "Operator",
        "PointerOrRef",
        "TemplateOpen",
        "TemplateClose",
        "Comma",
        "SingleString",
        "DoubleString",
        "Number",
        "Parenthesis",
        "ArrayIndex"
      ]
    },
    "TemplateGroup": {
      "type": "StartStop",
      "startRegex": "<",
      "endRegex": ">",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0x4ec9b0",
      "nestedTokens": [
        "LineComment",
        "BlockComment",
        "TaggedType",
        "Keyword",
        "DataType",
        "Variable",
        "ScopeResolution",
        "Operator",
        "PointerOrRef",
        "TemplateOpen",
        "TemplateClose",
        "Comma",
        "Number",
        "Parenthesis"
      ]
    },
    "TypeCast": {
      "type": "StartStop",
      "startRegex": "\\(",
      "endRegex": "\\)",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0x4ec9b0",
      "nestedTokens": [
        "TaggedType",
        "Keyword",
        "DataType",
        "Variable",
        "ScopeResolution",
        "PointerOrRef",
        "Comma",
        "Operator"
      ]
    },
    "DataType": {
      "type": "SimpleToken",
      "startRegex": "char8_t\\b|char16_t\\b|char32_t\\b|wchar_t\\b|int\\b|char\\b|double\\b|float\\b|void\\b|short\\b|long\\b|unsigned\\b|signed\\b|_Bool\\b|bool\\b|size_t\\b|ssize_t\\b|uint8_t\\b|uint16_t\\b|uint32_t\\b|uint64_t\\b|int8_t\\b|int16_t\\b|int32_t\\b|int64_t\\b|uintptr_t\\b|intptr_t\\b|ptrdiff_t\\b|[a-zA-Z_][a-zA-Z0-9_]*_(?:t|type|enum|e|s)\\b",
      "textColor": "0x4ec9b0"
    },
    "TagSpecifier": {
      "type": "SimpleToken",
      "startRegex": "struct\\b|union\\b|enum\\b|class\\b",
      "textColor": "0xc586c0"
    },
    "TaggedType": {
      "type": "Sequence",
      "nestedTokens": [
        "TagSpecifier",
        "TypeName"
      ]
    },
    "TypeName": {
      "type": "SimpleToken",
      "startRegex": "[a-zA-Z_][a-zA-Z0-9_]*",
      "textColor": "0x4ec9b0"
    }
  },
  "mergeSignIntoNumber": {
    "signTokens": [
      "Operator"
    ],
    "numberTokens": [
      "Number"
    ],
    "operandTokens": [
      "Number",
      "Variable",
      "Boolean",
      "SingleString",
      "DoubleString",
      "Parenthesis",
      "ArrayIndex",
      "CodeBlock"
    ]
  },
  "templateDisambiguation": {
    "templateOpenTokens": [
      "TemplateOpen"
    ],
    "templateCloseTokens": [
      "TemplateClose"
    ],
    "validInnerTokens": [
      "TypeName",
      "TaggedType",
      "DataType",
      "Keyword",
      "Variable",
      "Comma",
      "ScopeResolution",
      "PointerOrRef",
      "Number",
      "Parenthesis",
      "LineComment",
      "BlockComment",
      "TemplateOpen",
      "TemplateClose",
      "TemplateGroup"
    ],
    "invalidInnerOperators": [
      ";",
      "{",
      "}",
      "=",
      "+=",
      "-=",
      "*=",
      "/=",
      "==",
      "!=",
      "<=",
      ">=",
      "&&",
      "||",
      "++",
      "--"
    ],
    "templateGroupToken": "TemplateGroup"
  },
  "castDisambiguation": {
    "typeTokens": [
      "Keyword",
      "DataType",
      "TaggedType",
      "TypeName",
      "TagSpecifier"
    ],
    "typeKeywords": [
      "int",
      "char",
      "void",
      "float",
      "double",
      "short",
      "long",
      "unsigned",
      "signed",
      "size_t",
      "ssize_t",
      "uint8_t",
      "uint16_t",
      "uint32_t",
      "uint64_t",
      "int8_t",
      "int16_t",
      "int32_t",
      "int64_t",
      "uintptr_t",
      "intptr_t",
      "ptrdiff_t",
      "bool",
      "const",
      "volatile",
      "struct",
      "union",
      "enum",
      "auto",
      "typename"
    ],
    "typeSuffixes": [
      "_t",
      "_ptr",
      "_type"
    ],
    "castToken": "TypeCast"
  }
}