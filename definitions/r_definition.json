{
    "$schema": "../schema/textparser-schema.json",
    "formatVersion": 2,
    "name": "r",
    "version": 2.0,
    "caseSensitivity": true,
    "defaultFileExtensions": [
        "r",
        "R"
    ],
    "defaultTextEncoding": "utf-8",
    "supportedBom": [
        "utf-8"
    ],
    "otherTextInside": false,
    "diagnostics": {
        "expected": {
            "code": "R1001",
            "message": "Expected %s."
        },
        "tokenExpected": {
            "code": "R1002",
            "message": "'%s' expected."
        },
        "recovered": {
            "code": "R1003",
            "message": "Syntax error: unexpected token, recovering."
        }
    },
    "recovery": {
        "maximumDiagnostics": 100,
        "maximumSkippedTokens": 50,
        "maximumRecoveryAttempts": 30,
        "synchronizationTokens": [
            "Semicolon",
            "RBrace",
            "RParen",
            "RBracket",
            "RBracket2",
            "KwIf",
            "KwElse",
            "KwFor",
            "KwWhile",
            "KwRepeat",
            "KwFunction"
        ]
    },
    "lexer": {
        "initialMode": "default",
        "trivia": {
            "Whitespace": {
                "regex": "[ \\t\\r\\n]+",
                "priority": 1,
                "textColor": "0xd4d4d4"
            },
            "LineComment": {
                "regex": "#[^\\r\\n]*",
                "priority": 2,
                "textColor": "0x6a9955"
            }
        },
        "tokens": {
            "RawString": {
                "regex": "[rR]\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"|[rR]'(?:[^'\\\\\\r\\n]|\\\\.)*'",
                "priority": 31,
                "textColor": "0xce9178"
            },
            "DoubleString": {
                "regex": "\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"",
                "priority": 30,
                "textColor": "0xce9178"
            },
            "SingleString": {
                "regex": "'(?:[^'\\\\\\r\\n]|\\\\.)*'",
                "priority": 30,
                "textColor": "0xce9178"
            },
            "BacktickIdentifier": {
                "regex": "`(?:[^`\\\\\\r\\n]|\\\\.)*`",
                "priority": 30,
                "textColor": "0x9cdcfe"
            },
            "HexNumber": {
                "regex": "0[xX][0-9a-fA-F]+[lL]?",
                "priority": 32,
                "textColor": "0xb5cea8"
            },
            "FloatNumber": {
                "regex": "[0-9]+\\.[0-9]+(?:[eE][-+]?[0-9]+)?[i]?|\\.[0-9]+(?:[eE][-+]?[0-9]+)?[i]?|[0-9]+[eE][-+]?[0-9]+[i]?",
                "priority": 31,
                "textColor": "0xb5cea8"
            },
            "ComplexNumber": {
                "regex": "[0-9]+i",
                "priority": 31,
                "textColor": "0xb5cea8"
            },
            "DecNumber": {
                "regex": "[0-9]+[lL]?",
                "priority": 30,
                "textColor": "0xb5cea8"
            },
            "KwTrue": {
                "regex": "TRUE\\b(?![\\._])",
                "priority": 35,
                "textColor": "0x569cd6"
            },
            "KwFalse": {
                "regex": "FALSE\\b(?![\\._])",
                "priority": 35,
                "textColor": "0x569cd6"
            },
            "KwNull": {
                "regex": "NULL\\b(?![\\._])",
                "priority": 35,
                "textColor": "0x569cd6"
            },
            "KwNa": {
                "regex": "NA\\b(?![\\._])",
                "priority": 35,
                "textColor": "0x569cd6"
            },
            "KwInf": {
                "regex": "Inf\\b(?![\\._])",
                "priority": 35,
                "textColor": "0x569cd6"
            },
            "KwNan": {
                "regex": "NaN\\b(?![\\._])",
                "priority": 35,
                "textColor": "0x569cd6"
            },
            "KwNaInteger": {
                "regex": "NA_integer_\\b(?![\\._])",
                "priority": 35,
                "textColor": "0x569cd6"
            },
            "KwNaReal": {
                "regex": "NA_real_\\b(?![\\._])",
                "priority": 35,
                "textColor": "0x569cd6"
            },
            "KwNaComplex": {
                "regex": "NA_complex_\\b(?![\\._])",
                "priority": 35,
                "textColor": "0x569cd6"
            },
            "KwNaCharacter": {
                "regex": "NA_character_\\b(?![\\._])",
                "priority": 35,
                "textColor": "0x569cd6"
            },
            "KwFunction": {
                "regex": "function\\b(?![\\._])",
                "priority": 35,
                "textColor": "0xc586c0"
            },
            "KwIf": {
                "regex": "if\\b(?![\\._])",
                "priority": 35,
                "textColor": "0xc586c0"
            },
            "KwElse": {
                "regex": "else\\b(?![\\._])",
                "priority": 35,
                "textColor": "0xc586c0"
            },
            "KwFor": {
                "regex": "for\\b(?![\\._])",
                "priority": 35,
                "textColor": "0xc586c0"
            },
            "KwIn": {
                "regex": "in\\b(?![\\._])",
                "priority": 35,
                "textColor": "0xc586c0"
            },
            "KwWhile": {
                "regex": "while\\b(?![\\._])",
                "priority": 35,
                "textColor": "0xc586c0"
            },
            "KwRepeat": {
                "regex": "repeat\\b(?![\\._])",
                "priority": 35,
                "textColor": "0xc586c0"
            },
            "KwBreak": {
                "regex": "break\\b(?![\\._])",
                "priority": 35,
                "textColor": "0xc586c0"
            },
            "KwNext": {
                "regex": "next\\b(?![\\._])",
                "priority": 35,
                "textColor": "0xc586c0"
            },
            "KwReturn": {
                "regex": "return\\b(?![\\._])",
                "priority": 35,
                "textColor": "0xc586c0"
            },
            "ColonColonColon": {
                "regex": ":::",
                "priority": 34,
                "textColor": "0xd4d4d4"
            },
            "ColonColon": {
                "regex": "::",
                "priority": 33,
                "textColor": "0xd4d4d4"
            },
            "LeftSuperAssign": {
                "regex": "<<-",
                "priority": 34,
                "textColor": "0xd4d4d4"
            },
            "RightSuperAssign": {
                "regex": "->>",
                "priority": 34,
                "textColor": "0xd4d4d4"
            },
            "Pipe": {
                "regex": "\\|>",
                "priority": 34,
                "textColor": "0xd4d4d4"
            },
            "LeftAssign": {
                "regex": "<-",
                "priority": 33,
                "textColor": "0xd4d4d4"
            },
            "RightAssign": {
                "regex": "->",
                "priority": 33,
                "textColor": "0xd4d4d4"
            },
            "WalrusAssign": {
                "regex": ":=",
                "priority": 33,
                "textColor": "0xd4d4d4"
            },
            "Power": {
                "regex": "\\*\\*",
                "priority": 33,
                "textColor": "0xd4d4d4"
            },
            "LogicalAnd": {
                "regex": "&&",
                "priority": 33,
                "textColor": "0xd4d4d4"
            },
            "LogicalOr": {
                "regex": "\\|\\|",
                "priority": 33,
                "textColor": "0xd4d4d4"
            },
            "Equal": {
                "regex": "==",
                "priority": 33,
                "textColor": "0xd4d4d4"
            },
            "NotEqual": {
                "regex": "!=",
                "priority": 33,
                "textColor": "0xd4d4d4"
            },
            "LessEqual": {
                "regex": "<=",
                "priority": 33,
                "textColor": "0xd4d4d4"
            },
            "GreaterEqual": {
                "regex": ">=",
                "priority": 33,
                "textColor": "0xd4d4d4"
            },
            "LBracket2": {
                "regex": "\\[\\[",
                "priority": 33,
                "textColor": "0xffd700"
            },
            "RBracket2": {
                "regex": "\\]\\]",
                "priority": 33,
                "textColor": "0xffd700"
            },
            "SpecialInfix": {
                "regex": "%[^%\\r\\n]*%",
                "priority": 33,
                "textColor": "0xd4d4d4"
            },
            "Dollar": {
                "regex": "\\$",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "At": {
                "regex": "@",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Caret": {
                "regex": "\\^",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Tilde": {
                "regex": "~",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "BitwiseAnd": {
                "regex": "&",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "BitwiseOr": {
                "regex": "\\|",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Less": {
                "regex": "<",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Greater": {
                "regex": ">",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Assign": {
                "regex": "=",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Exclamation": {
                "regex": "!",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Plus": {
                "regex": "\\+",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Minus": {
                "regex": "-",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Star": {
                "regex": "\\*",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Slash": {
                "regex": "/",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Colon": {
                "regex": ":",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Question": {
                "regex": "\\?",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Backslash": {
                "regex": "\\\\",
                "priority": 32,
                "textColor": "0xc586c0"
            },
            "Comma": {
                "regex": ",",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "Semicolon": {
                "regex": ";",
                "priority": 32,
                "textColor": "0xd4d4d4"
            },
            "LParen": {
                "regex": "\\(",
                "priority": 32,
                "textColor": "0xffd700"
            },
            "RParen": {
                "regex": "\\)",
                "priority": 32,
                "textColor": "0xffd700"
            },
            "LBracket": {
                "regex": "\\[",
                "priority": 32,
                "textColor": "0xffd700"
            },
            "RBracket": {
                "regex": "\\]",
                "priority": 32,
                "textColor": "0xffd700"
            },
            "LBrace": {
                "regex": "\\{",
                "priority": 32,
                "textColor": "0xffd700"
            },
            "RBrace": {
                "regex": "\\}",
                "priority": 32,
                "textColor": "0xffd700"
            },
            "DotDotDot": {
                "regex": "\\.\\.\\.",
                "priority": 32,
                "textColor": "0x9cdcfe"
            },
            "DotDotIndex": {
                "regex": "\\.\\.[0-9]+",
                "priority": 32,
                "textColor": "0x9cdcfe"
            },
            "Identifier": {
                "regex": "(?:[a-zA-Z]|\\.[a-zA-Z_.])[a-zA-Z0-9_.]*|\\.(?![0-9])",
                "priority": 20,
                "textColor": "0x9cdcfe"
            }
        }
    },
    "operators": [
        {
            "token": "RightSuperAssign",
            "role": "infix",
            "precedence": 2,
            "associativity": "right"
        },
        {
            "token": "RightAssign",
            "role": "infix",
            "precedence": 2,
            "associativity": "right"
        },
        {
            "token": "LeftSuperAssign",
            "role": "infix",
            "precedence": 3,
            "associativity": "right"
        },
        {
            "token": "LeftAssign",
            "role": "infix",
            "precedence": 3,
            "associativity": "right"
        },
        {
            "token": "WalrusAssign",
            "role": "infix",
            "precedence": 3,
            "associativity": "right"
        },
        {
            "token": "Assign",
            "role": "infix",
            "precedence": 3,
            "associativity": "right"
        },
        {
            "token": "Tilde",
            "role": "infix",
            "precedence": 4,
            "associativity": "left"
        },
        {
            "token": "Pipe",
            "role": "infix",
            "precedence": 5,
            "associativity": "left"
        },
        {
            "token": "LogicalOr",
            "role": "infix",
            "precedence": 6,
            "associativity": "left"
        },
        {
            "token": "BitwiseOr",
            "role": "infix",
            "precedence": 7,
            "associativity": "left"
        },
        {
            "token": "LogicalAnd",
            "role": "infix",
            "precedence": 8,
            "associativity": "left"
        },
        {
            "token": "BitwiseAnd",
            "role": "infix",
            "precedence": 9,
            "associativity": "left"
        },
        {
            "token": "Equal",
            "role": "infix",
            "precedence": 10,
            "associativity": "left"
        },
        {
            "token": "NotEqual",
            "role": "infix",
            "precedence": 10,
            "associativity": "left"
        },
        {
            "token": "Less",
            "role": "infix",
            "precedence": 10,
            "associativity": "left"
        },
        {
            "token": "LessEqual",
            "role": "infix",
            "precedence": 10,
            "associativity": "left"
        },
        {
            "token": "Greater",
            "role": "infix",
            "precedence": 10,
            "associativity": "left"
        },
        {
            "token": "GreaterEqual",
            "role": "infix",
            "precedence": 10,
            "associativity": "left"
        },
        {
            "token": "Plus",
            "role": "infix",
            "precedence": 11,
            "associativity": "left"
        },
        {
            "token": "Minus",
            "role": "infix",
            "precedence": 11,
            "associativity": "left"
        },
        {
            "token": "Star",
            "role": "infix",
            "precedence": 12,
            "associativity": "left"
        },
        {
            "token": "Slash",
            "role": "infix",
            "precedence": 12,
            "associativity": "left"
        },
        {
            "token": "SpecialInfix",
            "role": "infix",
            "precedence": 13,
            "associativity": "left"
        },
        {
            "token": "Colon",
            "role": "infix",
            "precedence": 14,
            "associativity": "left"
        },
        {
            "token": "Caret",
            "role": "infix",
            "precedence": 15,
            "associativity": "right"
        },
        {
            "token": "Power",
            "role": "infix",
            "precedence": 15,
            "associativity": "right"
        }
    ],
    "grammar": {
        "start": "SourceFile",
        "productions": {
            "SourceFile": {
                "category": "source_file",
                "sequence": [
                    {
                        "repeat": {
                            "ref": "StatementItem"
                        }
                    }
                ]
            },
            "StatementItem": {
                "category": "statement",
                "choice": [
                    {
                        "token": "Semicolon"
                    },
                    {
                        "sequence": [
                            {
                                "ref": "Expression"
                            },
                            {
                                "optional": {
                                    "token": "Semicolon"
                                }
                            }
                        ]
                    },
                    {
                        "sequence": [
                            {
                                "not": {
                                    "token": "RBrace"
                                }
                            },
                            {
                                "ref": "InvalidStatement"
                            },
                            {
                                "optional": {
                                    "token": "Semicolon"
                                }
                            }
                        ]
                    }
                ]
            },
            "InvalidStatement": {
                "category": "statement",
                "ref": "Expression",
                "recoverUntil": [
                    "Semicolon",
                    "RBrace"
                ]
            },
            "Expression": {
                "category": "expression",
                "pratt": {
                    "primary": {
                        "ref": "UnaryExpression"
                    },
                    "minimumPrecedence": 1
                }
            },
            "UnaryExpression": {
                "category": "expression",
                "choice": [
                    {
                        "sequence": [
                            {
                                "choice": [
                                    {
                                        "token": "Plus"
                                    },
                                    {
                                        "token": "Minus"
                                    },
                                    {
                                        "token": "Exclamation"
                                    },
                                    {
                                        "token": "Tilde"
                                    },
                                    {
                                        "token": "Question"
                                    }
                                ]
                            },
                            {
                                "ref": "UnaryExpression"
                            }
                        ]
                    },
                    {
                        "ref": "PostfixExpression"
                    }
                ]
            },
            "PostfixExpression": {
                "category": "expression",
                "sequence": [
                    {
                        "ref": "PrimaryExpression"
                    },
                    {
                        "repeat": {
                            "choice": [
                                {
                                    "sequence": [
                                        {
                                            "token": "LParen"
                                        },
                                        {
                                            "optional": {
                                                "ref": "ArgumentList"
                                            }
                                        },
                                        {
                                            "token": "RParen"
                                        }
                                    ]
                                },
                                {
                                    "sequence": [
                                        {
                                            "token": "LBracket2"
                                        },
                                        {
                                            "optional": {
                                                "ref": "ArgumentList"
                                            }
                                        },
                                        {
                                            "token": "RBracket2"
                                        }
                                    ]
                                },
                                {
                                    "sequence": [
                                        {
                                            "token": "LBracket"
                                        },
                                        {
                                            "optional": {
                                                "ref": "ArgumentList"
                                            }
                                        },
                                        {
                                            "token": "RBracket"
                                        }
                                    ]
                                },
                                {
                                    "sequence": [
                                        {
                                            "token": "Dollar"
                                        },
                                        {
                                            "ref": "MemberIdentifier"
                                        }
                                    ]
                                },
                                {
                                    "sequence": [
                                        {
                                            "token": "At"
                                        },
                                        {
                                            "ref": "MemberIdentifier"
                                        }
                                    ]
                                },
                                {
                                    "sequence": [
                                        {
                                            "token": "ColonColonColon"
                                        },
                                        {
                                            "ref": "MemberIdentifier"
                                        }
                                    ]
                                },
                                {
                                    "sequence": [
                                        {
                                            "token": "ColonColon"
                                        },
                                        {
                                            "ref": "MemberIdentifier"
                                        }
                                    ]
                                }
                            ]
                        }
                    }
                ]
            },
            "MemberIdentifier": {
                "choice": [
                    {
                        "token": "Identifier"
                    },
                    {
                        "token": "BacktickIdentifier"
                    },
                    {
                        "token": "DoubleString"
                    },
                    {
                        "token": "SingleString"
                    }
                ]
            },
            "ArgumentList": {
                "sequence": [
                    {
                        "optional": {
                            "ref": "Argument"
                        }
                    },
                    {
                        "repeat": {
                            "sequence": [
                                {
                                    "token": "Comma"
                                },
                                {
                                    "optional": {
                                        "ref": "Argument"
                                    }
                                }
                            ]
                        }
                    }
                ]
            },
            "Argument": {
                "choice": [
                    {
                        "sequence": [
                            {
                                "ref": "MemberIdentifier"
                            },
                            {
                                "token": "Assign"
                            },
                            {
                                "optional": {
                                    "ref": "Expression"
                                }
                            }
                        ]
                    },
                    {
                        "ref": "Expression"
                    }
                ]
            },
            "PrimaryExpression": {
                "category": "expression",
                "choice": [
                    {
                        "ref": "ParenthesizedExpression"
                    },
                    {
                        "ref": "BlockExpression"
                    },
                    {
                        "ref": "FunctionDefinition"
                    },
                    {
                        "ref": "LambdaFunction"
                    },
                    {
                        "ref": "IfExpression"
                    },
                    {
                        "ref": "ForExpression"
                    },
                    {
                        "ref": "WhileExpression"
                    },
                    {
                        "ref": "RepeatExpression"
                    },
                    {
                        "ref": "ReturnExpression"
                    },
                    {
                        "token": "KwBreak"
                    },
                    {
                        "token": "KwNext"
                    },
                    {
                        "token": "KwTrue"
                    },
                    {
                        "token": "KwFalse"
                    },
                    {
                        "token": "KwNull"
                    },
                    {
                        "token": "KwNa"
                    },
                    {
                        "token": "KwInf"
                    },
                    {
                        "token": "KwNan"
                    },
                    {
                        "token": "KwNaInteger"
                    },
                    {
                        "token": "KwNaReal"
                    },
                    {
                        "token": "KwNaComplex"
                    },
                    {
                        "token": "KwNaCharacter"
                    },
                    {
                        "token": "HexNumber"
                    },
                    {
                        "token": "FloatNumber"
                    },
                    {
                        "token": "ComplexNumber"
                    },
                    {
                        "token": "DecNumber"
                    },
                    {
                        "token": "RawString"
                    },
                    {
                        "token": "DoubleString"
                    },
                    {
                        "token": "SingleString"
                    },
                    {
                        "token": "DotDotDot"
                    },
                    {
                        "token": "DotDotIndex"
                    },
                    {
                        "token": "BacktickIdentifier"
                    },
                    {
                        "token": "Identifier"
                    }
                ]
            },
            "ParenthesizedExpression": {
                "category": "expression",
                "astKind": "ParenthesizedExpression",
                "sequence": [
                    {
                        "token": "LParen"
                    },
                    {
                        "ref": "Expression"
                    },
                    {
                        "token": "RParen"
                    }
                ]
            },
            "BlockExpression": {
                "category": "expression",
                "astKind": "BlockExpression",
                "sequence": [
                    {
                        "token": "LBrace"
                    },
                    {
                        "repeat": {
                            "ref": "StatementItem"
                        }
                    },
                    {
                        "token": "RBrace"
                    }
                ]
            },
            "FunctionDefinition": {
                "category": "declaration",
                "astKind": "FunctionDefinition",
                "sequence": [
                    {
                        "token": "KwFunction"
                    },
                    {
                        "token": "LParen"
                    },
                    {
                        "optional": {
                            "ref": "ParameterList"
                        }
                    },
                    {
                        "token": "RParen"
                    },
                    {
                        "ref": "Expression"
                    }
                ]
            },
            "LambdaFunction": {
                "category": "declaration",
                "astKind": "LambdaFunction",
