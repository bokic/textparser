{
  "name": "bash",
  "version": 1.0,
  "caseSensitivity": true,
  "defaultFileExtensions": [
    "sh",
    "bash"
  ],
  "defaultTextEncoding": "latin1",
  "startTokens": [
    "LineComment",
    "Boolean",
    "Keyword",
    "Variable",
    "ParameterExpansion",
    "CommandSubstitution",
    "CodeBlock",
    "Operator",
    "SingleString",
    "DoubleString",
    "Number",
    "Parenthesis",
    "ArrayIndex"
  ],
  "otherTextInside": true,
  "tokens": {
    "LineComment": {
      "type": "SimpleToken",
      "startRegex": "#[^\\r\\n]*",
      "otherTextInside": true,
      "textColor": "0x6a9955"
    },
    "Keyword": {
      "type": "SimpleToken",
      "startRegex": "if\\b|then\\b|else\\b|elif\\b|fi\\b|for\\b|while\\b|until\\b|do\\b|done\\b|in\\b|case\\b|esac\\b|select\\b|function\\b|time\\b|local\\b|declare\\b|export\\b|readonly\\b|return\\b|exit\\b|break\\b|continue\\b|alias\\b|unalias\\b|builtin\\b|command\\b|eval\\b|exec\\b|shift\\b|source\\b|coproc\\b|let\\b|set\\b|unset\\b|trap\\b|typeset\\b|test\\b|echo\\b|printf\\b|read\\b|cd\\b|pwd\\b",
      "textColor": "0xc586c0"
    },
    "Boolean": {
      "type": "SimpleToken",
      "startRegex": "true\\b|false\\b",
      "textColor": "0x569cd6"
    },
    "Variable": {
      "type": "SimpleToken",
      "startRegex": "\\$[a-zA-Z_][a-zA-Z0-9_]*|\\$[@*#?$!_0-9-]|[a-zA-Z_][a-zA-Z0-9_]*(?=\\+=|=|:-|:=|:\\+|:\\?|:|/|#|%|\\^|,|\\[|\\]|\\})",
      "textColor": "0x9cdcfe"
    },
    "ParameterExpansion": {
      "type": "StartStop",
      "startRegex": "\\$\\{",
      "endRegex": "\\}",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0x9cdcfe",
      "nestedTokens": [
        "Variable",
        "ParameterExpansion",
        "Operator",
        "Number",
        "SingleString",
        "DoubleString",
        "CommandSubstitution",
        "Parenthesis",
        "ArrayIndex"
      ]
    },
    "CommandSubstitution": {
      "type": "StartStop",
      "startRegex": "`",
      "endRegex": "`",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xce9178",
      "nestedTokens": [
        "LineComment",
        "Boolean",
        "Keyword",
        "Variable",
        "ParameterExpansion",
        "CommandSubstitution",
        "CodeBlock",
        "Operator",
        "SingleString",
        "DoubleString",
        "Number",
        "Parenthesis",
        "ArrayIndex",
        "StringEscape"
      ]
    },
    "CodeBlock": {
      "type": "StartStop",
      "startRegex": "\\{",
      "endRegex": "\\}",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xffd700",
      "nestedTokens": [
        "LineComment",
        "Boolean",
        "Keyword",
        "Variable",
        "ParameterExpansion",
        "CommandSubstitution",
        "CodeBlock",
        "Operator",
        "SingleString",
        "DoubleString",
        "Number",
        "Parenthesis",
        "ArrayIndex"
      ]
    },
    "Operator": {
      "type": "SimpleToken",
      "startRegex": "&&|\\|\\||>>|<<|==|!=|\\+=|\\-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|\\+\\+|\\-\\-|;;|;&|;;&|\\|&|<<<|>&|<&|<=|>=|=~|:-|:=|:\\+|:\\?|//|##|%%|\\^\\^|,,|[-+*/%&|^~<>!=;.,|:]",
      "textColor": "0xd4d4d4"
    },
    "SingleString": {
      "type": "StartStop",
      "startRegex": "\\$?'",
      "endRegex": "'",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xce9178",
      "nestedTokens": [
        "StringEscape"
      ]
    },
    "DoubleString": {
      "type": "StartStop",
      "startRegex": "\\$?\"",
      "endRegex": "\"",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xce9178",
      "nestedTokens": [
        "StringEscape",
        "Variable",
        "ParameterExpansion",
        "CommandSubstitution"
      ]
    },
    "StringEscape": {
      "type": "SimpleToken",
      "startRegex": "\\\\\\\\|\\\\\\\"|\\\\\\'|\\\\n|\\\\r|\\\\t|\\\\\\$|\\\\\\`|\\\\a|\\\\b|\\\\e|\\\\f|\\\\v|\\\\x[0-9a-fA-F]{1,2}|\\\\[0-7]{1,3}",
      "textColor": "0xd7ba7d"
    },
    "Number": {
      "type": "SimpleToken",
      "startRegex": "0[xX][0-9a-fA-F]+|0[oO][0-7]+|0[bB][01]+|[0-9]+#[0-9a-zA-Z]+|[0-9]*\\.?[0-9]+(?:[eE][-+]?[0-9]+)?",
      "textColor": "0xb5cea8"
    },
    "Parenthesis": {
      "type": "StartStop",
      "startRegex": "\\(",
      "endRegex": "\\)",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xffd700",
      "nestedTokens": [
        "LineComment",
        "Boolean",
        "Keyword",
        "Variable",
        "ParameterExpansion",
        "CommandSubstitution",
        "CodeBlock",
        "Operator",
        "SingleString",
        "DoubleString",
        "Number",
        "Parenthesis",
        "ArrayIndex"
      ]
    },
    "ArrayIndex": {
      "type": "StartStop",
      "startRegex": "\\[",
      "endRegex": "\\]",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xffd700",
      "nestedTokens": [
        "LineComment",
        "Boolean",
        "Keyword",
        "Variable",
        "ParameterExpansion",
        "CommandSubstitution",
        "CodeBlock",
        "Operator",
        "SingleString",
        "DoubleString",
        "Number",
        "Parenthesis",
        "ArrayIndex"
      ]
    }
  },
  "mergeSignIntoNumber": {
    "signTokens": [
      "Operator"
    ],
    "numberTokens": [
      "Number"
    ],
    "operandTokens": [
      "Number",
      "Variable",
      "ParameterExpansion",
      "Boolean",
      "SingleString",
      "DoubleString",
      "CommandSubstitution",
      "Parenthesis",
      "ArrayIndex",
      "CodeBlock"
    ]
  }
}
