{
  "name": "json",
  "version": 1.0,
  "caseSensitivity": false,
  "defaultFileExtensions": [
    "json"
  ],
  "otherTextInside": false,
  "defaultTextEncoding": "latin1",
  "startTokens": [
    "Object",
    "Array"
  ],
  "tokens": {
    "Object": {
      "type": "StartStop",
      "startRegex": "{",
      "endRegex": "}",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xffd700",
      "nestedTokens": [
        "Key",
        "String",
        "KeyValueSeparator",
        "Value",
        "ValueSeparator"
      ]
    },
    "Array": {
      "type": "StartStop",
      "startRegex": "\\[",
      "endRegex": "\\]",
      "multiLine": true,
      "otherTextInside": true,
      "textColor": "0xffd700",
      "nestedTokens": [
        "String",
        "Number",
        "Object",
        "Array",
        "Bool",
        "Null",
        "ValueSeparator"
      ]
    },
    "Value": {
      "type": "GroupOneChildOnly",
      "nestedTokens": [
        "String",
        "Number",
        "Object",
        "Array",
        "Bool",
        "Null"
      ],
      "textColor": "0xce9178"
    },
    "Key": {
      "type": "StartStop",
      "otherTextInside": true,
      "startRegex": "\\\"(?=[^\\\"\\\\\\\\]*(?:\\\\\\\\.[^\\\"\\\\\\\\]*)*\\\"\\s*:)",
      "endRegex": "(\\\")\\s*:",
      "textColor": "0x9cdcfe",
      "nestedTokens": [
        "StringEscape"
      ],
      "delimiterTextColor": "0x6a9ec0"
    },
    "String": {
      "type": "StartStop",
      "otherTextInside": true,
      "startRegex": "\\\"",
      "endRegex": "\\\"",
      "textColor": "0xce9178",
      "nestedTokens": [
        "StringEscape"
      ],
      "delimiterTextColor": "0x9e6a57"
    },
    "Number": {
      "type": "SimpleToken",
      "startRegex": "\\d+(?:\\.\\d+)?(?:e[+-]?\\d+)?",
      "textColor": "0xb5cea8"
    },
    "StringEscape": {
      "type": "SimpleToken",
      "startRegex": "\\\\\\\\|\\\\\\/|\\\\b|\\\\f|\\\\n|\\\\r|\\\\t|\\\\u[0-9a-f]{4}",
      "textColor": "0xd7ba7d"
    },
    "Bool": {
      "type": "SimpleToken",
      "startRegex": "true|false",
      "textColor": "0x569cd6"
    },
    "Null": {
      "type": "SimpleToken",
      "startRegex": "null",
      "textColor": "0x569cd6"
    },
    "ValueSeparator": {
      "type": "SimpleToken",
      "startRegex": ",",
      "textColor": "0xd4d4d4"
    },
    "KeyValueSeparator": {
      "type": "SimpleToken",
      "startRegex": ":",
      "textColor": "0xd4d4d4"
    }
  }
}
